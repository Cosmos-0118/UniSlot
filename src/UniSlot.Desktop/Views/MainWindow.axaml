<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UniSlot.Desktop.ViewModels"
        xmlns:v="using:UniSlot.Desktop.Views"
        xmlns:conv="using:UniSlot.Desktop.Converters"
        xmlns:loc="using:UniSlot.Desktop.Services"
        x:Class="UniSlot.Desktop.Views.MainWindow"
        Title="UniSlot"
        Icon="avares://UniSlot/Assets/icon.png"
        Width="1180" Height="780" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:SolveViewModel"><v:SolveView /></DataTemplate>
    <DataTemplate DataType="vm:ResultsViewModel"><v:ResultsView /></DataTemplate>
    <DataTemplate DataType="vm:ScheduleViewModel"><v:ScheduleView /></DataTemplate>
    <DataTemplate DataType="vm:ClashesViewModel"><v:ClashesView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <LayoutTransformControl x:Name="ScaleHost">
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Classes="sidebar">
        <DockPanel Margin="16,24,16,18">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="12,0,0,28">
            <Image Classes="brandicon" Source="avares://UniSlot/Assets/icon.png" Width="28" Height="28" HorizontalAlignment="Left" />
            <TextBlock Classes="brand" Text="UniSlot" />
            <TextBlock Classes="muted tiny tagline" TextWrapping="Wrap" Text="{loc:T app.tagline}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="faint tiny version" Margin="12,0,0,0" Text="{Binding Version}" />
          <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:NavItem">
                <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="{Binding Title}">
                  <Path Classes="icon" Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}"
                        Stroke="{Binding $parent[ListBoxItem].Foreground}" />
                  <TextBlock Classes="navtext" Text="{Binding Title}" Foreground="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource Line}" />
      <ContentControl Grid.Column="2" Content="{Binding CurrentPage}" />
    </Grid>
  </LayoutTransformControl>
</Window>
