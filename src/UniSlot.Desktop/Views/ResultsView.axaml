<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UniSlot.Desktop.ViewModels"
             xmlns:loc="using:UniSlot.Desktop.Services"
             x:Class="UniSlot.Desktop.Views.ResultsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="{DynamicResource ContentMaxWidth}" Margin="{DynamicResource PagePadding}" Spacing="24">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="8">
          <TextBlock Classes="h1" Text="{loc:T results.title}" />
          <TextBlock Classes="muted" IsVisible="{Binding HasResults}" Text="{Binding FileLine}" />
          <TextBlock Classes="muted" IsVisible="{Binding IsEmpty}" Text="{loc:T results.empty}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Top" IsVisible="{Binding HasResults}"
                Command="{Binding OpenFolderCommand}" Content="{loc:T results.openFolder}" />
      </Grid>

      <StackPanel Spacing="24" IsVisible="{Binding HasResults}">

        <!-- Headline numbers -->
        <UniformGrid x:Name="Cards" Columns="4">
          <Border Classes="card" Margin="0,0,12,0">
            <StackPanel Spacing="6">
              <TextBlock Classes="colhead" Text="{loc:T card.red}" TextWrapping="Wrap" />
              <TextBlock Classes="metric" Text="{Binding Red}" />
              <TextBlock Classes="faint tiny" TextWrapping="Wrap" Text="{Binding RedHint}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,12,0">
            <StackPanel Spacing="6">
              <TextBlock Classes="colhead" Text="{loc:T card.clean}" TextWrapping="Wrap" />
              <TextBlock Classes="metric" Text="{Binding Clean}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,0,12,0">
            <StackPanel Spacing="6">
              <TextBlock Classes="colhead" Text="{loc:T card.sections}" TextWrapping="Wrap" />
              <TextBlock Classes="metric" Text="{Binding Sections}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="colhead" Text="{loc:T card.rules}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource Success}" IsVisible="{Binding RulesOk}" />
                <Path Classes="icon" Data="{StaticResource IconAlert}" Stroke="{DynamicResource Danger}" IsVisible="{Binding !RulesOk}" />
                <TextBlock Classes="h2" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding RulesText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Weekday balance -->
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="{loc:T results.balance}" />
            <ItemsControl ItemsSource="{Binding Bars}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:WeekdayBar">
                  <Grid ColumnDefinitions="110,*,56" Margin="0,5">
                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Name}" />
                    <ProgressBar Grid.Column="1" Classes="bar" Minimum="0" Maximum="1" Value="{Binding Fraction}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontWeight="Medium" Text="{Binding Sections}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Optimality and engine -->
        <Border Classes="card">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="4">
              <TextBlock Classes="colhead" Text="{loc:T results.engine}" />
              <TextBlock Text="{Binding Engine}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="colhead" Text="{loc:T results.reproduce}" />
              <TextBlock Classes="mono" Text="{Binding ReproCode}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2" Margin="0,16,0,0">
              <TextBlock Classes="h2" Text="{Binding ProofText}" />
              <TextBlock Classes="muted tiny" Text="{Binding BoundText}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- What limits the result -->
        <Border Classes="card" IsVisible="{Binding HasInsights}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{loc:T results.insights}" />
            <ItemsControl ItemsSource="{Binding Insights}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="16,*" Margin="0,3">
                    <TextBlock Foreground="{DynamicResource Faint}" Text="•" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Classes="muted" Text="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="notice-warning" IsVisible="{Binding HasWarnings}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Foreground="{DynamicResource Warning}" Text="{loc:T results.warnings}" />
            <ItemsControl ItemsSource="{Binding Warnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Classes="tiny" TextWrapping="Wrap" Text="{Binding}" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
