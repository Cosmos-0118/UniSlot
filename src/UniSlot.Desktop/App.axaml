<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniSlot.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Defaults; ResponsiveLayout replaces these at runtime as the window changes size. -->
      <x:Double x:Key="ContentMaxWidth">980</x:Double>
      <x:Double x:Key="NarrowMaxWidth">820</x:Double>
      <Thickness x:Key="PagePadding">48,40,48,40</Thickness>
      <GridLength x:Key="ColPrograms">170</GridLength>
      <GridLength x:Key="ColFaculty">160</GridLength>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://UniSlot/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
