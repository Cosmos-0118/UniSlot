{
  "name": "unislot",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "bin": {
    "unislot": "./cli/bin/unislot.mjs"
  },
  "scripts": {
    "unislot": "tsx --tsconfig tsconfig.json cli/index.ts",
    "setup": "node scripts/setup.mjs",
    "setup:cpsat": "tsx --tsconfig tsconfig.json scripts/setup-cpsat.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "exceljs": {
      "archiver": "^7.0.1",
      "fast-csv": "^5.0.8",
      "unzipper": "^0.12.5",
      "uuid": "^11.1.1"
    },
    "archiver-utils": {
      "glob": "^13.0.6"
    },
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
